digraph O { graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", labelloc=t, label="ORGANIGRAMA FUNCIONAL PROPUESTO", fontsize=20, fontname="Arial"]; node [shape=box, style="rounded,filled", fillcolor="#EEF5FB", color="#47769C", fontname="Arial", fontsize=11, margin="0.18,0.12"]; edge [color="#52677A", arrowsize=.8]; coord [label="Coordinación de gestión inmobiliaria", fillcolor="#E4F2E8"]; admin [label="Administrador de la plataforma"]; consulta [label="Usuario de consulta"]; prom [label="Promotores / responsables\n(entregan información; sin acceso directo)"]; coord -> admin; admin -> consulta [style=dashed, label="gestiona permisos de uso"]; prom -> admin [label="entrega datos y soportes", dir=forward]; }