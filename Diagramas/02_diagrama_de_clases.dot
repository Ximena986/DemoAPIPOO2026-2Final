digraph G { graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.55", labelloc=t, label="DIAGRAMA DE CLASES – MÓDULO DE PROYECTOS", fontsize=20, fontname="Arial", splines=ortho]; node [shape=record, style="filled", fillcolor="#F1F6FA", color="#47769C", fontname="Arial", fontsize=9, margin="0.08,0.05"]; edge [fontname="Arial", fontsize=9, color="#52677A", arrowsize=0.8]; c [label="{ProyectosController| - servicio: IProyectoServicio| + ObtenerTodos()\l+ ObtenerConsolidados()\l+ ObtenerPorId(id)\l+ Crear(dto)\l+ Actualizar(id,dto)\l+ Eliminar(id)\l}"]; is [label="{IProyectoServicio| + ObtenerTodos()\l+ ObtenerConsolidados()\l+ ObtenerPorId()\l+ Crear()\l+ Actualizar()\l+ Eliminar()\l}"]; s [label="{ProyectoServicio| - repositorio: IProyectoRepositorio\l- factory: IConsolidacionFactory| + operaciones de negocio()\l- ValidarDatos()\l}"]; ir [label="{IProyectoRepositorio| + ObtenerTodos()\l+ ObtenerPorId()\l+ Crear()\l+ Actualizar()\l+ Eliminar()\l}"]; r [label="{ProyectoRepositorio| - contexto: DatosInmobiliariosContexto| + operaciones CRUD()\l}"]; ctx [label="{DatosInmobiliariosContexto| - proyectos: List<ProyectoInmobiliario>\l- siguienteId: int| + ObtenerTodos()\l+ BuscarPorId()\l+ Agregar()\l+ Actualizar()\l+ Eliminar()\l}"]; m [label="{ProyectoInmobiliario| + Id: int\l+ Nombre: string\l+ Promotor: string\l+ Municipio: string\l+ Tipo: string\l+ AreaMetrosCuadrados: decimal\l+ ValorEstimado: decimal\l+ TieneLicencia: bool\l+ TieneConceptoUsoSuelo: bool\l+ EstadoConsolidacion: string\l}"]; f [label="{IConsolidacionFactory / ConsolidacionFactory| + Crear(tipo): IConsolidacionStrategy\l}"]; st [label="{IConsolidacionStrategy| + Evaluar(proyecto): string\l}"]; u [label="{ConsolidacionUrbanaStrategy| + Evaluar(proyecto): string\l}"]; rr [label="{ConsolidacionRuralStrategy| + Evaluar(proyecto): string\l}"]; dto [label="{ProyectoDTO| + Nombre: string\l+ Promotor: string\l+ Municipio: string\l+ Tipo: string\l+ AreaMetrosCuadrados: decimal\l+ ValorEstimado: decimal\l+ TieneLicencia: bool\l+ TieneConceptoUsoSuelo: bool\l}"]; c -> is [label="depende de"]; s -> ir [label="depende de"]; r -> ctx [label="utiliza"]; ctx -> m [label="almacena"]; s -> f [label="solicita estrategia"]; f -> st [label="crea"]; u -> st [style=dashed, arrowhead=empty, label="implementa"]; rr -> st [style=dashed, arrowhead=empty, label="implementa"]; c -> dto [style=dashed, label="recibe"]; s -> m [style=dashed, label="construye y evalúa"]; }