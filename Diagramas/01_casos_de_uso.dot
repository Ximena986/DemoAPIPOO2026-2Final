digraph G { graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.55", ranksep="0.8", labelloc=t, label="DIAGRAMA DE CASOS DE USO", fontsize=22, fontname="Arial"]; node [fontname="Arial", fontsize=12]; edge [fontname="Arial", fontsize=10, color="#52677A"]; subgraph cluster_api { label="API de proyectos inmobiliarios"; style="rounded"; color="#6D91B5"; penwidth=1.5; node [shape=ellipse, style=filled, fillcolor="#EEF5FB", color="#47769C"]; login [label="Iniciar sesión"]; list [label="Consultar proyectos"]; filt [label="Filtrar por municipio y tipo"]; cons [label="Consultar proyectos consolidados"]; id [label="Consultar proyecto por ID"]; create [label="Registrar proyecto"]; update [label="Actualizar proyecto"]; delete [label="Eliminar proyecto"]; } admin [shape=box, style="rounded", label="Administrador", fillcolor="#E4F2E8"]; consulta [shape=box, style="rounded", label="Usuario de consulta", fillcolor="#E4F2E8"]; admin -> login; admin -> list; admin -> filt; admin -> cons; admin -> id; admin -> create; admin -> update; admin -> delete; consulta -> login; consulta -> list; consulta -> filt; consulta -> cons; consulta -> id; }