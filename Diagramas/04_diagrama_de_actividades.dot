digraph G { graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", labelloc=t, label="DIAGRAMA DE ACTIVIDADES – SOLICITUD PROTEGIDA", fontsize=20, fontname="Arial"]; node [shape=box, style="rounded,filled", fillcolor="#EEF5FB", color="#47769C", fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, color="#52677A"]; inicio [shape=circle, label="", width=.18, fillcolor="#315F80"]; cred [label="El usuario envía usuario y contraseña"]; val [shape=diamond, label="¿Credenciales válidas?", width=2.0, height=.8]; token [label="Generar JWT con usuario y rol"]; req [label="Enviar solicitud a endpoint protegido"]; jwt [shape=diamond, label="¿JWT válido y vigente?", width=2.0, height=.8]; rol [shape=diamond, label="¿Rol autorizado para la operación?", width=2.2, height=.9]; negocio [label="Ejecutar controlador y reglas de negocio"]; datos [shape=diamond, label="¿Datos válidos?", width=1.8, height=.8]; ok [label="Procesar operación y responder 200/201/204", fillcolor="#E6F3E9"]; badcred [label="401 – Credenciales incorrectas", fillcolor="#FCE9E7"]; badjwt [label="401 – Token ausente, inválido o vencido", fillcolor="#FCE9E7"]; forbidden [label="403 – Rol sin permiso", fillcolor="#FCE9E7"]; baddata [label="400 – Datos inválidos", fillcolor="#FCE9E7"]; fin [shape=doublecircle, label="", width=.2, fillcolor="#315F80"]; inicio -> cred -> val; val -> token [label="Sí"]; val -> badcred [label="No"]; token -> req -> jwt; jwt -> rol [label="Sí"]; jwt -> badjwt [label="No"]; rol -> negocio [label="Sí"]; rol -> forbidden [label="No"]; negocio -> datos; datos -> ok [label="Sí"]; datos -> baddata [label="No"]; ok -> fin; badcred -> fin; badjwt -> fin; forbidden -> fin; baddata -> fin; }